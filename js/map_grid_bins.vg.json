            "lon": 147.33,
            "lat": -42.88,
            "dx": 8,
            "dy": 4,
            "a": "left"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 600,
        "color": "#12263a",
        "baseline": "middle",
        "dx": {
          "expr": "datum.dx"
        },
        "dy": {
          "expr": "datum.dy"
        },
        "align": {
          "expr": "datum.a"
        },
        "stroke": "white",
        "strokeWidth": 3,
        "strokeOpacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "c"
        }
      }
    },
