{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 4. Grid bin map: pools counted in 1° x 1° grid cells (about 100 km), so crowded cities can be compared with the outback.",
  "title": {
    "text": "Where pools cluster",
    "subtitle": "Number of pools in each 1° grid cell (about 100 km across)"
  },
  "width": "container",
  "height": 380,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef3f6",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/osm_public_pools.csv"
      },
      "transform": [
        {
          "filter": "datum.category != 'ocean_or_natural'"
        },
        {
          "filter": "datum.lon > 112 && datum.lon < 154.5 && datum.lat < -9"
        },
        {
          "calculate": "floor(datum.lon) + 0.5",
          "as": "cell_lon"
        },
        {
          "calculate": "floor(datum.lat) + 0.5",
          "as": "cell_lat"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "pools"
            }
          ],
          "groupby": [
            "cell_lon",
            "cell_lat"
          ]
        },
        {
          "calculate": "datum.pools >= 50 ? '50+' : datum.pools >= 25 ? '25–49' : datum.pools >= 10 ? '10–24' : datum.pools >= 5 ? '5–9' : datum.pools >= 2 ? '2–4' : '1'",
          "as": "band"
        }
      ],
      "mark": {
        "type": "square",
        "opacity": 1,
        "size": {
          "expr": "pow(width / 44, 2)"
        }
      },
      "encoding": {
        "longitude": {
          "field": "cell_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cell_lat",
          "type": "quantitative"
        },
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "Pools per cell",
          "scale": {
            "domain": [
              "1",
              "2–4",
              "5–9",
              "10–24",
              "25–49",
              "50+"
            ],
            "range": [
              "#d6e8f5",
              "#a8cde9",
              "#6aaad8",
              "#3482c3",
              "#1f5f9c",
              "#0b3a66"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 160,
            "columns": 6,
            "columnPadding": 8,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "pools",
            "title": "Pools in this cell"
          },
          {
            "field": "cell_lat",
            "title": "Latitude",
            "format": ".1f"
          },
          {
            "field": "cell_lon",
            "title": "Longitude",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "c": "Sydney",
            "lon": 151.2,
            "lat": -33.87,
            "dx": 13,
            "dy": 0,
            "a": "left"
          },
          {
            "c": "Melbourne",
