          },
          {
            "c": "Brisbane",
            "lon": 153.03,
            "lat": -27.47,
            "dx": 13,
            "dy": 0,
            "a": "left"
          },
          {
            "c": "Perth",
            "lon": 115.86,
            "lat": -31.95,
            "dx": -8,
            "dy": 0,
            "a": "right"
          },
          {
            "c": "Adelaide",
            "lon": 138.6,
            "lat": -34.93,
            "dx": -6,
            "dy": 14,
            "a": "right"
          },
          {
            "c": "Darwin",
            "lon": 130.84,
            "lat": -12.46,
            "dx": -6,
            "dy": -8,
