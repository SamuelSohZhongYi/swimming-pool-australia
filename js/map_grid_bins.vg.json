  "config": {
    "view": {
      "stroke": null
    },
    "font": "Public Sans",
    "title": {
      "font": "Fraunces",
      "fontSize": 20,
      "fontWeight": 800,
      "color": "#12263a",
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5d6e",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4a5d6e",
      "titleColor": "#4a5d6e",
      "domainColor": "#c3d1db",
      "tickColor": "#c3d1db",
      "gridColor": "#e6edf2",
      "labelLimit": 300
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#4a5d6e",
      "labelColor": "#4a5d6e",
      "labelLimit": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelFont": "Public Sans",
      "labelFontWeight": 600,
      "labelColor": "#12263a",
      "titleFontSize": 0
    }
  }
}