{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 5. Proportional symbol map: number of public-owned (council) and privately run public-access pools in each state. Circle area is proportional to the number of pools.",
  "title": {
    "text": "Most pools belong to local councils",
    "subtitle": "Number of pools in each state, by who owns them (circle area = number of pools)"
  },
  "width": "container",
  "height": 520,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef3f6",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/rls_pools_by_state_2024.csv"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/rls_pool_access_by_state.csv"
            },
            "key": "state",
            "fields": [
              "label_lon",
              "label_lat"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.label_lon)",
          "as": "label_lon"
        },
        {
          "calculate": "toNumber(datum.label_lat)",
          "as": "label_lat"
        },
        {
          "calculate": "datum.state_abbr == 'ACT' ? 151.2 : datum.label_lon",
          "as": "lon0"
        },
        {
          "calculate": "datum.state_abbr == 'ACT' ? -34.6 : datum.label_lat",
          "as": "lat0"
        },
        {
          "fold": [
            "public_owned",
            "public_accessible"
          ],
          "as": [
            "owner_key",
            "pools"
          ]
        },
        {
          "calculate": "datum.owner_key == 'public_owned' ? 'Council / government owned' : 'Private, open to the public'",
          "as": "Owner"
        },
        {
          "calculate": "datum.owner_key == 'public_owned' ? datum.lon0 - 1.3 : datum.lon0 + 1.3",
          "as": "lon"
        },
        {
          "calculate": "datum.lat0",
          "as": "lat"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.85,
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "pools",
              "type": "quantitative",
              "title": "Pools",
              "scale": {
                "range": [
                  20,
                  2400
                ]
              },
              "legend": {
                "orient": "bottom-left",
                "values": [
                  50,
                  200,
                  400
                ],
                "symbolFillColor": "#9fb0bf",
                "symbolStrokeColor": "#9fb0bf"
              }
            },
            "color": {
              "field": "Owner",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Council / government owned",
                  "Private, open to the public"
                ],
                "range": [
                  "#1f6fb4",
                  "#e8833a"
                ]
              },
              "legend": {
                "orient": "top-left",
                "symbolType": "circle",
                "symbolSize": 150
              }
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State"
              },
              {
                "field": "Owner"
              },
              {
                "field": "pools",
                "type": "quantitative",
                "title": "Pools"
              },
              {
                "field": "total_pools",
                "type": "quantitative",
                "title": "All pools in state"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.owner_key == 'public_owned'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -34,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#12263a"
          },
          "encoding": {
            "longitude": {
              "field": "lon0",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat0",
              "type": "quantitative"
            },
            "text": {
              "field": "state_abbr"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Public Sans",
    "title": {
      "font": "Fraunces",
      "fontSize": 20,
      "fontWeight": 800,
      "color": "#12263a",
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5d6e",
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4a5d6e",
      "titleColor": "#4a5d6e",
      "domainColor": "#c3d1db",
      "tickColor": "#c3d1db",
      "gridColor": "#e6edf2",
      "labelLimit": 300
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#4a5d6e",
      "labelColor": "#4a5d6e",
      "labelLimit": 400
    },
    "header": {
      "labelFontSize": 13,
      "labelFont": "Public Sans",
      "labelFontWeight": 600,
      "labelColor": "#12263a",
      "titleFontSize": 0
    }
  }
}